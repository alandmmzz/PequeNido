# Copiá este archivo como .env.local y pegá tu connection string de Neon
# (Neon dashboard -> tu proyecto -> Connect -> "Connection string", con sslmode=require)
DATABASE_URL="postgresql://usuario:password@ep-xxxxx.neon.tech/dbname?sslmode=require"

# --- Mercado Pago (Checkout Pro) ---
# Sacalo de https://www.mercadopago.com.ar/developers/panel/app -> tu app -> "Credenciales de prueba"
# (o "Credenciales de producción" cuando esté listo para cobrar de verdad)
MERCADOPAGO_ACCESS_TOKEN="TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000"

# Moneda en la que vas a cobrar (todos los precios del catálogo están en UYU).
MERCADOPAGO_CURRENCY="UYU"

# URL pública de tu sitio (sin barra final). Mercado Pago la necesita para
# redirigir de vuelta al comprador y para mandar el webhook de pagos.
# En local, si querés probar el webhook de verdad, usá una URL de ngrok/tunnel.
NEXT_PUBLIC_URL="http://localhost:3000"
